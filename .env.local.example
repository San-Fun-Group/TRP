# Supabase — copy to .env.local and fill in your project values
# Project URL and anon key are safe to expose (protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER SIDE ONLY. Never commit this value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
